# Personal Twin — configuration. Copy to `.env` and adjust. All vars use the TWIN_ prefix.
# Only the variables for your chosen profile are required; the rest have sane defaults.

# --- Core ---
TWIN_APP_ENV=dev                 # dev | test | prod
TWIN_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# --- HTTP ---
TWIN_API_HOST=0.0.0.0
TWIN_API_PORT=8000
TWIN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Config files & data ---
TWIN_MODELS_CONFIG_PATH=models.yaml
TWIN_SOURCES_CONFIG_PATH=sources.yaml
# TWIN_MODELS_PROFILE=local      # profile in models.yaml; unset = the file's default_profile
TWIN_DATA_DIR=data

# --- Providers (only what your profile uses) ---
TWIN_OLLAMA_BASE_URL=http://localhost:11434
# TWIN_ANTHROPIC_API_KEY=sk-ant-...
# TWIN_OPENAI_API_KEY=sk-...

# --- Vector store ---
TWIN_VECTOR_STORE_BACKEND=chroma # chroma | pgvector
TWIN_CHROMA_PATH=data/chroma
# TWIN_DATABASE_URL=postgresql://twin:twin@localhost:5432/twin   # only for pgvector

# --- Chunking / retrieval ---
TWIN_CHUNK_SIZE=800
TWIN_CHUNK_OVERLAP=120
TWIN_RETRIEVAL_TOP_K=5

# --- Observability ---
TWIN_PERSIST_TRACES=true
TWIN_TRACE_DIR=runs
TWIN_LANGSMITH_TRACING=false
# TWIN_LANGSMITH_API_KEY=ls-...
TWIN_LANGSMITH_PROJECT=personal-twin
# TWIN_LANGSMITH_ENDPOINT=
